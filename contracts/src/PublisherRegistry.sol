pragma solidity 0.8.24;

import {Ownable2Step, Ownable} from "@openzeppelin/contracts/access/Ownable2Step.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import {EIP712} from "@openzeppelin/contracts/utils/cryptography/EIP712.sol";
import {SignatureChecker} from "@openzeppelin/contracts/utils/cryptography/SignatureChecker.sol";
import {SafeCast} from "@openzeppelin/contracts/utils/math/SafeCast.sol";
import {IPublisherRegistry} from "./interfaces/IPublisherRegistry.sol";

/**
 * @title PublisherRegistry
 * @notice Authoritative registry binding normalized domains to publisher owner wallets and authorized signing keys.
 * @dev Implements the ADR-011 Dual-Authorization model: initial domain registration requires both an authorized
 * registrar transaction (following off-chain DNS TXT validation) AND a cryptographically signed EIP-712 registration
 * intent from the publisher wallet.
 */
contract PublisherRegistry is IPublisherRegistry, Ownable2Step, ReentrancyGuard, EIP712 {
    struct DomainRecord {
        address owner;
        uint64 registeredAt;
        bool isSuspended;
        string domain;
        mapping(address => KeyStatus) authorizedKeys;
    }

    /// @notice EIP-712 typehash for publisher registration intent
    bytes32 public constant REGISTRATION_AUTHORIZATION_TYPEHASH = keccak256(
        "RegistrationAuthorization(string domain,address publisher,address initialSigningKey,uint256 nonce,uint64 deadline)"
    );

    /// @notice Authorized registrar address permitted to relay newly verified domains
    address public registrar;

    /// @notice Nonce tracker for publisher registration intents (replay prevention)
    mapping(address => uint256) public nonces;

    /// @notice Mapping of keccak256(bytes(domain)) to DomainRecord
    mapping(bytes32 => DomainRecord) private _domains;

    modifier onlyRegistrar() {
        if (msg.sender != registrar) revert NotRegistrar();
        _;
    }

    modifier onlyDomainOwner(string calldata domain) {
        bytes32 dHash = keccak256(bytes(domain));
        address owner = _domains[dHash].owner;
        if (owner == address(0)) revert DomainNotRegistered();
        if (owner != msg.sender) revert NotDomainOwner();
        _;
    }

    /**
     * @notice Initializes the PublisherRegistry with an initial registrar and governance owner.
     * @param initialRegistrar Address authorized to submit verified domain registrations.
     */
    constructor(address initialRegistrar) Ownable(msg.sender) EIP712("LUCENTRA", "1") {
        if (initialRegistrar == address(0)) revert ZeroAddress();
        registrar = initialRegistrar;
        emit RegistrarUpdated(address(0), initialRegistrar, SafeCast.toUint64(block.timestamp));
    }

    /**
     * @notice Registers a newly verified domain using the ADR-011 Dual-Authorization mechanism.
     * @dev Callable strictly by the authorized registrar role. Requires an EIP-712 registration intent
     * signed by the genuine publisher wallet, preventing unilateral registrar domain assignments.
     * @param domain The canonical normalized domain string (UTS #46 form).
     * @param publisher The verified publisher wallet address.
     * @param initialSigningKey The initial release signing key authorized for this domain.
     * @param deadline Unix timestamp after which the publisher's registration intent signature expires.
     * @param publisherSignature EIP-712 signature generated by the publisher wallet.
     */
    function registerPublisherDomainWithAuth(
        string calldata domain,
        address publisher,
        address initialSigningKey,
        uint64 deadline,
        bytes calldata publisherSignature
    ) external nonReentrant onlyRegistrar {
        if (bytes(domain).length == 0) revert EmptyDomainString();
        if (publisher == address(0) || initialSigningKey == address(0)) revert ZeroAddress();
        if (block.timestamp > deadline) revert SignatureExpired();

        bytes32 dHash = keccak256(bytes(domain));
        if (_domains[dHash].owner != address(0)) revert DomainAlreadyRegistered();

        uint256 currentNonce = nonces[publisher];
        _verifyRegistrationAuth(dHash, publisher, initialSigningKey, currentNonce, deadline, publisherSignature);
        nonces[publisher] = currentNonce + 1;

        uint64 currentTime = SafeCast.toUint64(block.timestamp);
        DomainRecord storage rec = _domains[dHash];
        rec.owner = publisher;
        rec.registeredAt = currentTime;
        rec.domain = domain;
        rec.authorizedKeys[initialSigningKey] = KeyStatus.ACTIVE;

        emit DomainRegisteredByRegistrar(dHash, domain, publisher, initialSigningKey, currentTime);
        emit KeyAuthorized(dHash, initialSigningKey, currentTime);
    }

    function _verifyRegistrationAuth(
        bytes32 domainHash,
        address publisher,
        address initialSigningKey,
        uint256 nonce,
        uint64 deadline,
        bytes calldata signature
    ) internal view {
        bytes32 structHash = keccak256(
            abi.encode(REGISTRATION_AUTHORIZATION_TYPEHASH, domainHash, publisher, initialSigningKey, nonce, deadline)
        );
        bytes32 digest = _hashTypedDataV4(structHash);
        if (!SignatureChecker.isValidSignatureNow(publisher, digest, signature)) {
            revert InvalidSignature();
        }
    }

    /**
     * @notice Authorizes a new release signing key for a registered domain.
     * @dev Governed exclusively by the domain owner wallet.
     * @param domain Target registered domain.
     * @param signingKey Address of the new signing key to authorize.
     */
    function authorizeKey(string calldata domain, address signingKey) external onlyDomainOwner(domain) {
        if (signingKey == address(0)) revert ZeroAddress();
        bytes32 dHash = keccak256(bytes(domain));
        DomainRecord storage rec = _domains[dHash];

        if (rec.isSuspended) revert PublisherIsSuspended();
        if (rec.authorizedKeys[signingKey] == KeyStatus.REVOKED) revert KeyAlreadyRevoked();
        if (rec.authorizedKeys[signingKey] == KeyStatus.ACTIVE) revert KeyAlreadyActive();

        rec.authorizedKeys[signingKey] = KeyStatus.ACTIVE;
        emit KeyAuthorized(dHash, signingKey, SafeCast.toUint64(block.timestamp));
    }

    /**
     * @notice Atomically rotates an active signing key to a new key.
     * @dev Governed exclusively by the domain owner wallet.
     * @param domain Target registered domain.
     * @param oldKey Currently active signing key to revoke.
     * @param newKey New signing key to authorize.
     */
    function rotateKey(string calldata domain, address oldKey, address newKey) external onlyDomainOwner(domain) {
        if (oldKey == address(0) || newKey == address(0)) revert ZeroAddress();
        if (oldKey == newKey) revert KeyAlreadyActive();

        bytes32 dHash = keccak256(bytes(domain));
        DomainRecord storage rec = _domains[dHash];

        if (rec.isSuspended) revert PublisherIsSuspended();
        if (rec.authorizedKeys[oldKey] != KeyStatus.ACTIVE) revert KeyNotActive();
        if (rec.authorizedKeys[newKey] == KeyStatus.REVOKED) revert KeyAlreadyRevoked();
        if (rec.authorizedKeys[newKey] == KeyStatus.ACTIVE) revert KeyAlreadyActive();

        rec.authorizedKeys[oldKey] = KeyStatus.REVOKED;
        rec.authorizedKeys[newKey] = KeyStatus.ACTIVE;

        uint64 currentTime = SafeCast.toUint64(block.timestamp);
        emit KeyRevoked(dHash, oldKey, currentTime);
        emit KeyAuthorized(dHash, newKey, currentTime);
        emit KeyRotated(dHash, oldKey, newKey, currentTime);
    }

    /**
     * @notice Permanently revokes an active release signing key.
     * @dev Governed exclusively by the domain owner wallet. Once revoked, a key can never be re-authorized.
     * @param domain Target registered domain.
     * @param signingKey Address of the key to revoke.
     */
    function revokeKey(string calldata domain, address signingKey) external onlyDomainOwner(domain) {
        if (signingKey == address(0)) revert ZeroAddress();
        bytes32 dHash = keccak256(bytes(domain));
        DomainRecord storage rec = _domains[dHash];

        if (rec.authorizedKeys[signingKey] != KeyStatus.ACTIVE) revert KeyNotActive();

        rec.authorizedKeys[signingKey] = KeyStatus.REVOKED;
        emit KeyRevoked(dHash, signingKey, SafeCast.toUint64(block.timestamp));
    }

    /**
     * @notice Suspends a publisher domain, temporarily invalidating all its release signing keys.
     * @dev Callable by the domain owner, the registrar (upon DNS ownership loss detection),
     * or governance contract owner (emergency dispute intervention).
     * @param domain Target domain to suspend.
     */
    function suspendPublisher(string calldata domain) external {
        bytes32 dHash = keccak256(bytes(domain));
        DomainRecord storage rec = _domains[dHash];

        if (rec.owner == address(0)) revert DomainNotRegistered();
        if (msg.sender != rec.owner && msg.sender != registrar && msg.sender != owner()) {
            revert NotDomainOwner();
        }
        if (rec.isSuspended) revert PublisherIsSuspended();

        rec.isSuspended = true;
        emit PublisherSuspended(dHash, SafeCast.toUint64(block.timestamp));
    }

    /**
     * @notice Reactivates a suspended publisher domain.
     * @dev Callable by the contract owner (governance) or by the domain owner if self-suspended.
     * @param domain Target domain to reactivate.
     */
    function reactivatePublisher(string calldata domain) external {
        bytes32 dHash = keccak256(bytes(domain));
        DomainRecord storage rec = _domains[dHash];

        if (rec.owner == address(0)) revert DomainNotRegistered();
        if (msg.sender != rec.owner && msg.sender != owner()) {
            revert NotDomainOwner();
        }
        if (!rec.isSuspended) revert PublisherNotSuspended();

        rec.isSuspended = false;
        emit PublisherReactivated(dHash, SafeCast.toUint64(block.timestamp));
    }

    /**
     * @notice Queries whether a signing key is currently active and authorized for a domain.
     * @param domain Normalized domain string.
     * @param signingKey Address of the signing key.
     * @return True if domain is registered, not suspended, and key is ACTIVE.
     */
    function isKeyAuthorized(string calldata domain, address signingKey) external view returns (bool) {
        return isKeyAuthorizedByHash(keccak256(bytes(domain)), signingKey);
    }

    /**
     * @notice Gas-optimized query using precomputed keccak256 domain hash.
     * @param domainHash Keccak-256 hash of normalized domain string.
     * @param signingKey Address of the signing key.
     * @return True if domain is registered, not suspended, and key is ACTIVE.
     */
    function isKeyAuthorizedByHash(bytes32 domainHash, address signingKey) public view returns (bool) {
        DomainRecord storage rec = _domains[domainHash];
        if (rec.owner == address(0) || rec.isSuspended) {
            return false;
        }
        return rec.authorizedKeys[signingKey] == KeyStatus.ACTIVE;
    }

    /**
     * @notice Returns the registered owner address for a domain.
     */
    function getDomainOwner(string calldata domain) external view returns (address) {
        return getDomainOwnerByHash(keccak256(bytes(domain)));
    }

    /**
     * @notice Returns the registered owner address using precomputed domain hash.
     */
    function getDomainOwnerByHash(bytes32 domainHash) public view returns (address) {
        return _domains[domainHash].owner;
    }

    /**
     * @notice Checks if a publisher domain is suspended.
     */
    function isPublisherSuspended(string calldata domain) external view returns (bool) {
        bytes32 dHash = keccak256(bytes(domain));
        DomainRecord storage rec = _domains[dHash];
        if (rec.owner == address(0)) revert DomainNotRegistered();
        return rec.isSuspended;
    }

    /**
     * @notice Returns basic metadata for a registered domain.
     */
    function getDomainInfo(string calldata domain) external view returns (DomainInfo memory) {
        bytes32 dHash = keccak256(bytes(domain));
        DomainRecord storage rec = _domains[dHash];
        if (rec.owner == address(0)) revert DomainNotRegistered();
        return DomainInfo({
            owner: rec.owner, registeredAt: rec.registeredAt, isSuspended: rec.isSuspended, domain: rec.domain
        });
    }

    /**
     * @notice Returns the EIP-712 domain separator for this contract.
     */
    function DOMAIN_SEPARATOR() external view returns (bytes32) {
        return _domainSeparatorV4();
    }

    /**
     * @notice Updates the authorized registrar address.
     * @dev Restricted strictly to contract owner (Governance Multisig).
     * @param newRegistrar New registrar address.
     */
    function setRegistrar(address newRegistrar) external onlyOwner {
        if (newRegistrar == address(0)) revert ZeroAddress();
        emit RegistrarUpdated(registrar, newRegistrar, SafeCast.toUint64(block.timestamp));
        registrar = newRegistrar;
    }
}
