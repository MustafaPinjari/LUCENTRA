{
  "name": "lucentra-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "LUCENTRA -- Trust, made verifiable. Internet authenticity and verification infrastructure.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:core": "npm --prefix packages/core run build",
    "test:core": "npm --prefix packages/core test",
    "typecheck:core": "npm --prefix packages/core run typecheck",
    "demo:core": "npm --prefix packages/core run demo"
  }
}
