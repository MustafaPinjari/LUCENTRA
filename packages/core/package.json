    "demo": "node dist/src/demo.js"
  },
  "dependencies": {
    "canonicalize": "^2.0.0",
    "viem": "^2.10.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  }
}

