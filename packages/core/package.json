{
  "name": "@lucentra/core",
  "version": "0.1.0",
  "description": "LUCENTRA Cryptographic Core Engine: Canonicalization, Hashing, EIP-712 Signing and Release Verification",
  "type": "module",
  "main": "./dist/src/index.js",
