# LUCENTRA Backend Environment Configuration
# Copy this file to .env for local development

# Django Settings
DEBUG=True
SECRET_KEY=lucentra-local-development-secret-key-change-in-production-123456
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Blockchain / Node Subprocess Configuration
ANVIL_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CORE_PACKAGE_CLI_PATH=../../packages/core/dist/src/cli.js
DEPLOYMENT_CONFIG_PATH=../../deployments/local/deployment.json

# Local Registrar Key (Used ONLY on local testnet Anvil account 1 for automated registration)
# NEVER commit or use real private keys in production
REGISTRAR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# DNS Verification
DNS_CHALLENGE_PREFIX=_lucentra-verification
DNS_CHALLENGE_TTL_SECONDS=900
DNS_CHALLENGE_MAX_ATTEMPTS=5
DNS_TIMEOUT_SECONDS=5.0
